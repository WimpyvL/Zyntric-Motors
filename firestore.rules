rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        request.auth.token.email == 'loop69org@gmail.com'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Helpers
    function isValidProduct(data) {
      return data.keys().hasAll(['sku', 'name', 'price', 'stock']) &&
             data.sku is string && data.sku.size() <= 100 &&
             data.name is string && data.name.size() <= 200 &&
             data.brand is string && data.brand.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.stock in ['in_stock', 'low_stock', 'out_of_stock'];
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['customer', 'total', 'status', 'date']) &&
             data.customer is string && data.customer.size() <= 200 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'processing', 'shipped', 'delivered'] &&
             data.date is string;
    }

    function isValidSupplier(data) {
      return data.keys().hasAll(['name', 'email', 'status']) &&
             data.name is string && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 200 &&
             data.status in ['active', 'paused', 'inactive'];
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role']) &&
             data.email is string && data.email.size() <= 200 &&
             data.role in ['customer', 'installer', 'admin'];
    }

    // 0.1 Connectivity check
    match /system/{docId} {
      allow read: if isSignedIn() && isValidId(docId);
    }

    // 1. Products
    match /products/{productId} {
      allow read: if true; // Publicly viewable catalog
      allow write: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
    }

    // 2. Orders
    match /orders/{orderId} {
      allow read: if (isAdmin() || (isSignedIn() && existing().customerId == request.auth.uid)) && isValidId(orderId);
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming()) && incoming().customerId == request.auth.uid;
      allow update: if isAdmin() && isValidId(orderId) && isValidOrder(incoming());
      allow delete: if false; 
    }

    // 3. Suppliers
    match /suppliers/{supplierId} {
      allow read: if isAdmin() && isValidId(supplierId);
      allow write: if isAdmin() && isValidId(supplierId) && isValidSupplier(incoming());
    }

    // 4. Users
    match /users/{userId} {
      allow read: if (isAdmin() || isOwner(userId)) && isValidId(userId);
      allow create: if isSignedIn() && isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && 
                    (incoming().role == 'customer' || request.auth.token.email == 'loop69org@gmail.com');
      allow update: if (isOwner(userId) && isValidId(userId) && (
                      (incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone'])) ||
                      (request.auth.token.email == 'loop69org@gmail.com')
                    )) || 
                    (isAdmin() && isValidId(userId) && isValidUser(incoming()));
    }
  }
}
