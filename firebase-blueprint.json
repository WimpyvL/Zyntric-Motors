{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A car part in the inventory",
      "type": "object",
      "properties": {
        "sku": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "stock": { "type": "string", "enum": ["in_stock", "low_stock", "out_of_stock"] },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "fits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "make": { "type": "string" },
              "model": { "type": "string" },
              "year": { "type": "number" }
            }
          }
        }
      },
      "required": ["sku", "name", "price", "stock"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "customer": { "type": "string" },
        "date": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered"] },
        "items": { "type": "number" },
        "fulfillment": { "type": "string" }
      },
      "required": ["customer", "total", "status", "date"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "A warehouse or distribution partner",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "contact": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "paused", "inactive"] },
        "rating": { "type": "number" },
        "ordersFulfilled": { "type": "number" }
      },
      "required": ["name", "email", "status"]
    },
    "User": {
      "title": "User",
      "description": "A user of the platform",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "installer", "admin"] },
        "joined": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Global inventory of parts"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase history"
    },
    "/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "Warehouse partner directory"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and roles"
    }
  }
}
