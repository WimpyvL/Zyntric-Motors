{
  "id": "zyntric-motors-backend-shp2",
  "lang": "typescript",
  "global_cors": {
    "allow_headers": [
      "Authorization",
      "Content-Type"
    ],
    "allow_origins_without_credentials": [
      "*"
    ],
    "allow_origins_with_credentials": [
      "http://localhost:3000",
      "https://*.vercel.app",
      "https://zyntricmotors.co.za",
      "https://www.zyntricmotors.co.za"
    ]
  }
}
