# Optional admin password for the local UI password gate.
# This only unlocks the frontend admin screens. It does not authorize backend writes.
# If omitted, the frontend falls back to: zyntric-admin
VITE_ADMIN_PASSWORD="change-this-password"

# Optional Encore backend base URL.
# Leave unset for mock-data mode.
VITE_API_BASE_URL=""

# Optional admin credential for Encore catalogue write endpoints.
# This is a temporary frontend seam, not a final auth design.
VITE_API_ADMIN_TOKEN=""
